<div class="slab slab--thin slab--dark-blue search-brief">
    <div class="slab__wrapper">
        <form method="get" action="/catalog/" id="search" class="search-form section-nav">
            <label for="search-keywords" class="heading__text">Search ExploreUK</label>
            <div class="control-group">
                <input type="text"
                    id="search-keywords"
                    name="q"
                    class="input-text heading__text"
                    value="{{q}}"
                />
                <button class="icon-only">
                    <span class="icon-label">
                        <span class="ic ic--magnify" aria-hidden="true"></span>
                        <span class="label">search</span>
                    </span>
                </button>
            </div>
        </form>
    </div>
</div>
