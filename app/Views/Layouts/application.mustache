<!doctype html>
<html lang="en">
<head>
  <title>{{title}}{{^title}}Welcome to ExploreUK{{/title}}</title>
  {{#css}}
  <link rel="stylesheet" href="{{href}}">
  {{/css}}
  {{> head-common}}
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-FPRYLHP028"></script>
  <script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-FPRYLHP028', { 'anonymize_ip': true });
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=UA-23584444-4"></script>
</head>
<body>
  {{> nav}}
  <main id="content">
  {{> maintenance_notice}}
  <div class="slab">
    <div class="slab__wrapper">
      <div class="heading-section">
        <h1 class="heading--display">
            <span>{{title}}{{^title}}Welcome to ExploreUK{{/title}}</span>
        </h1>
        {{#requestable}}
        {{> advance_note}}
        {{/requestable}}
        {{#requestable}}
        {{{requests}}}
        {{/requestable}}
     </div>
      <div class="grid grid--major-right">
        <div class="grid__column grid__column--minor">
          {{{toc}}}
        </div>
        <div class="grid__column grid__column--major editorial">
            {{{content}}}
        </div>
      </div>
    </div>
  </div>
  </main>
  {{> global-footer}}
  {{> universal-footer}}
  {{> limestone-resources}}
  {{#js}}
  <script src="{{href}}?hash={{hash}}"></script>
  {{/js}}
  <script src="https://webcdn.uky.edu/limestone/1.0.0/js/lib/jquery-accessible-accordion.js"></script>
  <script>jQuery('.js-accordion').accordion({ buttonsGeneratedContent: 'html' });</script>
  {{#requestable}}
  <script>
  requests.init({
      title: "{{title}}",
      button_active: "Selected",
      button_inactive: "Select",
      button_toc_active: "Selected",
      button_toc_inactive: "Select this collection"
  });
  </script>
  {{/requestable}}
  <script>
  jQuery(function () {
      function highlight_current() {
          jQuery('.fa-toc-entry').each(function () {
              if (jQuery(this).attr('href') === window.location.hash) {
                  jQuery(this).addClass('fa-toc-entry-highlight');
              } else {
                  jQuery(this).removeClass('fa-toc-entry-highlight');
              }
          });
      }
      jQuery(window).on('hashchange', function () { highlight_current(); });
      highlight_current();
  });
  </script>
  {{>viewer}}
</body>
</html>
