<!doctype html>
<html lang="en">
<head>
  <title>{{title}}{{^title}}Welcome to ExploreUK{{/title}}</title>
  {{> head-common}}
</head>
<body>
  {{> maintenance_notice}}
  {{> nav}}
  <div class="slab slab--wildcat-white page-header page-header--text">
    <div class="slab__wrapper">
      <h1 class="headline-group">
        <span class="headline-group__head">
          {{title}}{{^title}}Welcome to ExploreUK{{/title}}
        </span>
      </h1>
    </div>
  </div>

  {{> breadcrumbs}}

  <main id="content">
    <div class="slab{{#reproductions_only}} fa-restricted-collection{{/reproductions_only}}">
      <div class="slab__wrapper">
        {{#reproductions_only}}
        <div class="fa-reproductions-only-notice">
          {{> reproductions_only_notice}}
        </div>
        {{/reproductions_only}}
        <div class="grid grid--major-right">
          <div class="grid__column grid__column--minor">
            {{{toc}}}
            {{#requestable}}
            {{> contact_info}}
            {{/requestable}}
            {{#requestable}}
            {{{requests}}}
            {{/requestable}}
          </div>
          <!--<div class="grid__column grid__column--major">-->
              {{{content}}}
          <!--</div>-->
        </div>
      </div>
    </div>
    <div class="slab slab--wildcat-white">
        {{> harmful_language_statement}}
    </div>
    {{> sponsors}}
  </main>
  {{> global-footer}}
  {{> universal-footer}}
  {{> limestone-resources}}
  {{#js}}
  <script src="{{href}}?{{version}}"></script>
  {{/js}}
  {{#requestable}}
  <script>
  requests.init({
      title: "{{title}}",
      button_active: "Remove",
      button_inactive: "Request",
      button_collection_active: "Remove Collection",
      button_collection_inactive: "Add Collection to Request",
      reproductions_only: {{#reproductions_only}}true{{/reproductions_only}}{{^reproductions_only}}false{{/reproductions_only}}
  });
  </script>
  {{/requestable}}
  {{>viewer}}
</body>
</html>
