<!doctype html>
<html lang="en">
<head>
  <title>{{title}}{{^title}}Welcome to ExploreUK{{/title}}</title>
  {{#css}}
  <link rel="stylesheet" href="{{href}}">
  {{/css}}
  {{> head-common}}
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-FPRYLHP028"></script>
  <script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-FPRYLHP028', { 'anonymize_ip': true });
  </script>
  <script async src="https://www.googletagmanager.com/gtag/js?id=UA-23584444-4"></script>
</head>
<body>
  {{> maintenance_notice}}
  {{> nav}}
  <div class="slab slab--wildcat-white page-header page-header--text">
    <div class="slab__wrapper">
      <h1 class="headline-group">
        <span class="headline-group__head">
          {{title}}{{^title}}Welcome to ExploreUK{{/title}}
        </span>
      </h1>
    </div>
  </div>

  {{> breadcrumbs}}

  <main id="content">
    <div class="slab">
      <div class="slab__wrapper">
        <div class="grid grid--major-right">
          <div class="grid__column grid__column--minor">
            {{{toc}}}
            {{#requestable}}
            {{> contact_info}}
            {{/requestable}}
            {{#requestable}}
            {{{requests}}}
            {{/requestable}}
          </div>
          <!--<div class="grid__column grid__column--major">-->
              {{{content}}}
          <!--</div>-->
        </div>
      </div>
    </div>
       <div class="slab slab--wildcat-white">
        {{> harmful_language_statement}}
    </div>
  </main>
   
  {{> global-footer}}
  {{> universal-footer}}
  {{> limestone-resources}}
  {{#js}}
  <script src="{{href}}?hash={{hash}}"></script>
  {{/js}}
  <script>jQuery('.js-accordion').accordion({ buttonsGeneratedContent: 'html' });</script>
  <script>
  jQuery(function () {
      // Limestone's image-gallery.js defines image_gallery() but never calls it
      if (typeof image_gallery === 'function') {
          image_gallery();
      }
      // Masonry measures image heights at init, but thumbnails lazy-load via
      // unveil, so re-layout each gallery as its images actually arrive.
      jQuery('.image-gallery').each(function () {
          var gallery = this;
          var pending;
          gallery.addEventListener('load', function () {
              clearTimeout(pending);
              pending = setTimeout(function () {
                  jQuery(gallery).masonry('layout');
              }, 50);
          }, true);
      });
  });
  </script>
  {{#requestable}}
  <script>
  requests.init({
      title: "{{title}}",
      button_active: "Remove request",
      button_inactive: "Request item",
      //button_toc_active: "Selected",
      //button_toc_inactive: "Select this collection"
  });
  </script>
  {{/requestable}}
  <script>
  jQuery(function () {
      function highlight_current() {
          jQuery('.fa-toc-entry').each(function () {
              if (jQuery(this).attr('href') === window.location.hash) {
                  jQuery(this).addClass('fa-toc-entry-highlight');
              } else {
                  jQuery(this).removeClass('fa-toc-entry-highlight');
              }
          });
      }
      jQuery(window).on('hashchange', function () { highlight_current(); });
      highlight_current();
  });
  </script>
  {{>viewer}}
</body>
</html>
