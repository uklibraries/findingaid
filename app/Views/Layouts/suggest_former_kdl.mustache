<!DOCTYPE html>
<html lang="en">
    <head>
        <title>Error | KDL resource change</title>
        {{> head-common}}
    </head>
    <body>
        {{> maintenance_notice}}
        {{> nav}}

        <div class="slab slab--wildcat-white page-header page-header--text">
            <div class="slab__wrapper">
                <h1 class="headline-group">
                <span class="headline-group__head">
                    {{title}}
                </span>
                </h1>
            </div>
        </div>

        {{> breadcrumbs}}

        <main id="content">
            <div class="slab__wrapper">
                <div class="alert in-page-alert">
                    <div class="icon-wrapper">
                        <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="24" cy="24" r="24" fill="#1E8AFF"></circle>
                            <rect x="22" y="12" width="4.54545" height="4.54545" fill="white"></rect>
                            <rect x="22" y="19.9545" width="4.54545" height="17.0455" fill="white"></rect>
                        </svg>
                    </div>
                    <div class="message">
                        <h2>This Kentucky Digital Library resource has changed</h2>
                        <p>
                            The <a href="https://kdl.kyvl.org" rel="noopener">Kentucky Digital Library</a> changed October 1, 2019.  Some materials are no longer available on ExploreUK.
                        </p>

                    </div>
                </div>
            </div>
            <div class="slab">
                <div class="slab__wrapper">
                    <div class="editorial">
                        <p>This resource belongs to <a href="{{repo_url}}" rel="noopener">{{repository}}</a>.</p>
                        <p>You may be able to find {{title}} at <a href="{{repo_url}}" rel="noopener">{{repo_url}}</a>.</p>
                        <p>
                        <a href="https://kdl.kyvl.org" rel="noopener"><img class="logo" src="images/KDL_Logo.png" alt="Kentucky Digital Library"></a>
                        </p>
                    </div>
                </div>
            </div>
        </main>
        {{> global-footer}}
        {{> universal-footer}}
        {{> limestone-resources}}
    </body>
</html>
