<div id="{{heading_id}}" class="slab fa-component left-border">
  <div class="text-center checkered-divider">
    <svg id="blueCheckered" width="100%" height="50px" xmlns="http://www.w3.org/2000/svg">
      <svg y="5px" height="50px" x="50%" overflow="visible" width="80px">
        <rect stroke="#b1c9e8" id="svg_2" height="20px" width="20px" stroke-width="1" fill="none" y="0px" x="20px"></rect>
        <rect stroke="#b1c9e8" id="svg_3" height="20px" width="20px" y="20px" stroke-width="1" fill="none" x="-40px"></rect>
        <rect stroke="#b1c9e8" id="svg_4" height="20px" width="20px" y="0px" stroke-width="1" fill="none" x="-20px"></rect>
        <rect stroke="#b1c9e8" id="svg_5" height="20px" width="20px" y="20px" stroke-width="1" fill="none" x="0px"></rect>
      </svg>
      <line stroke-linecap="null" stroke-linejoin="null" id="svg_6" y2="25px" x2="100%" y1="25px" x1="0" stroke-width="1" stroke="#b1c9e8" fill="none"></line>
    </svg>
  </div>
  <div class="slab__wrapper">
    {{#collapsible}}
    <div class="js-accordion">
      <div class="js-accordion__panel">
        {{#heading}}
        {{#native}}
        <{{tag}} class="js-accordion__header headline-group">
          <span class="headline-group__head">{{{label}}}</span>
        </{{tag}}>
        {{/native}}
        {{^native}}
        <div role="heading" aria-level="{{level}}" class="js-accordion__header headline-group">
          <span class="headline-group__head">{{{label}}}</span>
        </div>
        {{/native}}
        {{/heading}}
        <div class="editorial">
          {{#has_media}}
          <dl class="fa-availability">
            <dt class="show-for-sr">Availability</dt>
            <dd>available online - request to view on-site</dd>
          </dl>
          {{/has_media}}
          {{^has_media}}
          {{#has_container_lists}}
          <dl class="fa-availability">
            <dt class="show-for-sr">Availability</dt>
            <dd>non-digitized material - request to view on-site</dd>
          </dl>
          {{/has_container_lists}}
          {{/has_media}}
          {{#has_media}}
          <div class="image-gallery">
            <div class="image-gallery__block-sizer"></div>
            {{#links}}
            {{> media}}
            {{/links}}
          </div>
          {{#has_image_overflow}}
          <p class="image-gallery__controls">{{> image_controls}}</p>
          {{/has_image_overflow}}
          {{/has_media}}
          {{#container_lists}}
          <ul class="fa-component list-unstyled">
            {{{container_list}}}
          </ul>
          {{/container_lists}}
          {{#bioghist_head}}
          {{#note_heading}}
          {{#native}}<{{tag}}>{{{p}}}</{{tag}}>{{/native}}
          {{^native}}<div role="heading" aria-level="{{level}}">{{{p}}}</div>{{/native}}
          {{/note_heading}}
          {{/bioghist_head}}
          {{#bioghist}}
          <p>{{{p}}}</p>
          {{/bioghist}}
          {{#scopecontent_head}}
          {{#note_heading}}
          {{#native}}<{{tag}}>{{{p}}}</{{tag}}>{{/native}}
          {{^native}}<div role="heading" aria-level="{{level}}">{{{p}}}</div>{{/native}}
          {{/note_heading}}
          {{/scopecontent_head}}
          {{#scopecontent}}
          <p>{{{p}}}</p>
          {{/scopecontent}}
          {{#processinfo}}
          <p>{{{p}}}</p>
          {{/processinfo}}
          {{#subcomponents}}
          {{{subcomponent}}}
          {{/subcomponents}}
        </div>
      </div>
    </div>
    {{/collapsible}}

    {{^collapsible}}
    {{#heading}}
    {{#native}}
    <{{tag}} class="headline-group">
      <span class="headline-group__head">{{{label}}}</span>
    </{{tag}}>
    {{/native}}
    {{^native}}
    <div role="heading" aria-level="{{level}}" class="headline-group">
      <span class="headline-group__head">{{{label}}}</span>
    </div>
    {{/native}}
    {{/heading}}
   <div class="editorial">
      {{#has_media}}
      <dl class="fa-availability">
        <dt class="show-for-sr">Availability</dt>
        <dd>available online - request to view on-site</dd>
      </dl>
      {{/has_media}}
      {{^has_media}}
      {{#has_container_lists}}
      <dl class="fa-availability">
        <dt class="show-for-sr">Availability</dt>
        <dd>non-digitized material - request to view on-site</dd>
      </dl>
      {{/has_container_lists}}
      {{/has_media}}
      {{#has_media}}
      <div class="image-gallery">
        <div class="image-gallery__block-sizer"></div>
        {{#links}}
        {{> media}}
        {{/links}}
      </div>
      {{#has_image_overflow}}
      <p class="image-gallery__controls">{{> image_controls}}</p>
      {{/has_image_overflow}}
      {{/has_media}}
      <ul class="container_list list-unstyled">
        {{#container_lists}}
        {{{container_list}}}
        {{/container_lists}}
      </ul>
      {{#bioghist_head}}
      {{#note_heading}}
      {{#native}}<{{tag}}>{{{p}}}</{{tag}}>{{/native}}
      {{^native}}<div role="heading" aria-level="{{level}}">{{{p}}}</div>{{/native}}
      {{/note_heading}}
      {{/bioghist_head}}
      {{#bioghist}}
      <p>{{{p}}}</p>
      {{/bioghist}}
      {{#scopecontent_head}}
      {{#note_heading}}
      {{#native}}<{{tag}}>{{{p}}}</{{tag}}>{{/native}}
      {{^native}}<div role="heading" aria-level="{{level}}">{{{p}}}</div>{{/native}}
      {{/note_heading}}
      {{/scopecontent_head}}
      {{#scopecontent}}
      <p>{{{p}}}</p>
      {{/scopecontent}}
      {{#processinfo}}
      <p>{{{p}}}</p>
      {{/processinfo}}
    </div>
    {{/collapsible}}
  </div>
</div>


